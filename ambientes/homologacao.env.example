# Ambiente de HOMOLOGAÇÃO: onde uma mudança é validada antes de ir para produção.
# Copie para ambientes/homologacao.env (fora do Git). scripts/implantar.sh gera as senhas na 1ª vez se faltarem.

MILEBAG_AMBIENTE=homologacao
# Faixa no topo do app avisando que não é produção (vazio = sem faixa).
MILEBAG_AMBIENTE_ROTULO=Homologação

# Endereço pelo qual o navegador abre o app (o Caddy encaminha /api para a API nessa mesma origem).
MILEBAG_URL_PUBLICA=http://localhost:8081
MILEBAG_PORTA_HTTP=8081
MILEBAG_SITE=:80

# Perfil do Spring: o mesmo de produção, para validar o comportamento real.
MILEBAG_PERFIL_SPRING=prod
# Documentação da API em /docs: ligada para quem testa.
MILEBAG_DOCUMENTACAO_API=true

# Contas de teste (admin, empresa e motorista, senha 12345678). A API só as cria com o segredo de JWT de
# desenvolvimento abaixo; por isso a homologação NUNCA pode ficar exposta à internet com estes valores.
MILEBAG_CONTAS_DE_TESTE=true
MILEBAG_JWT_SECRET=dev-only-secret-nao-usar-em-producao-0123456789abcdef

MILEBAG_PG_ADMIN_SENHA=
MILEBAG_PG_APP_SENHA=

# Motor de rotas: por padrão o Valhalla do compose de desenvolvimento (docker compose up -d valhalla).
MILEBAG_VALHALLA_URL=http://host.docker.internal:8002

# Bot do Telegram (HU18). Desligado até existir o bot: crie com o @BotFather, ligue aqui e registre o webhook
# com scripts/telegram-webhook.sh (exige HTTPS público). O mesmo segredo vai aqui e no setWebhook.
# Para testar sem bot, MILEBAG_TELEGRAM_API_URL pode apontar para scripts/fake-telegram.cjs.
MILEBAG_TELEGRAM_HABILITADO=false
MILEBAG_TELEGRAM_BOT_TOKEN=
MILEBAG_TELEGRAM_BOT_USERNAME=
MILEBAG_TELEGRAM_WEBHOOK_SECRET=
MILEBAG_TELEGRAM_API_URL=https://api.telegram.org

# E-mail. Desligado por padrão. Para usar o servidor de DESENVOLVIMENTO (docker compose up -d mail na raiz, depois
# scripts/configurar-mail.sh e scripts/gerar-truststore.sh), descomente: o e-mail só entrega para @milebag.local.
# MILEBAG_MAIL_DESENVOLVIMENTO=true
# MILEBAG_SMTP_HABILITADO=true
# MILEBAG_SMTP_HOST=mail.milebag.local
# MILEBAG_SMTP_PORT=5587
# MILEBAG_SMTP_USUARIO=noreply@milebag.local
# MILEBAG_SMTP_SENHA=milebag-dev-1234
# MILEBAG_SMTP_REMETENTE=noreply@milebag.local
# MILEBAG_MENSAGERIA_IMAP_HABILITADO=true
# MILEBAG_MENSAGERIA_IMAP_HOST=mail.milebag.local
# MILEBAG_MENSAGERIA_IMAP_PORT=9993
# MILEBAG_MENSAGERIA_IMAP_USUARIO=mensagens@milebag.local
# MILEBAG_MENSAGERIA_IMAP_SENHA=milebag-dev-1234
