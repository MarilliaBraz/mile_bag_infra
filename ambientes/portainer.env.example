# Produção numa stack do Portainer (servidor com proxy HTTPS próprio, ex.: Nginx Proxy Manager).
# Copiado para ambientes/portainer.env (fora do Git) por scripts/empacotar-portainer.sh, que gera as senhas, o segredo
# do JWT e o par VAPID na 1ª vez. Esses valores não mudam entre versões: trocar as senhas depois que o banco existe
# quebra o acesso a ele.

# Endereço público: vai para dentro do app no build (chamadas à API) e para o CORS da API.
MILEBAG_URL_PUBLICA=https://www.milebag.com.br
# Porta da máquina para onde o proxy do servidor encaminha o domínio.
MILEBAG_PORTA_HTTP=8090

MILEBAG_JWT_SECRET=
MILEBAG_PG_ADMIN_SENHA=
MILEBAG_PG_APP_SENHA=

# Contato real exigido pela política de uso do Nominatim público.
MILEBAG_NOMINATIM_USER_AGENT=milebag-api (marillia.dev@gmail.com)

# Bot do Telegram (HU18): desligado até existir o bot.
MILEBAG_TELEGRAM_HABILITADO=false
MILEBAG_TELEGRAM_BOT_TOKEN=
MILEBAG_TELEGRAM_BOT_USERNAME=
MILEBAG_TELEGRAM_WEBHOOK_SECRET=
MILEBAG_TELEGRAM_API_URL=https://api.telegram.org

# E-mail: desligado até existir a conta remetente (o formulário de demonstração responde com o WhatsApp).
MILEBAG_SMTP_HABILITADO=false
MILEBAG_SMTP_HOST=
MILEBAG_SMTP_PORT=587
MILEBAG_SMTP_USUARIO=
MILEBAG_SMTP_SENHA=
MILEBAG_SMTP_REMETENTE=
MILEBAG_IMAP_HABILITADO=false
MILEBAG_IMAP_HOST=
MILEBAG_IMAP_USUARIO=
MILEBAG_IMAP_SENHA=
MILEBAG_MENSAGERIA_IMAP_HABILITADO=false
MILEBAG_MENSAGERIA_IMAP_HOST=
MILEBAG_MENSAGERIA_IMAP_USUARIO=
MILEBAG_MENSAGERIA_IMAP_SENHA=
MILEBAG_MENSAGERIA_DOMINIO_EMAIL=

MILEBAG_PUSH_ASSUNTO=mailto:marillia.dev@gmail.com
