# Ambiente de PRODUÇÃO: só recebe versões já validadas em homologação (main ou tag vX.Y.Z).
# Copie para ambientes/producao.env (fora do Git). scripts/implantar.sh gera as senhas e o segredo do JWT na 1ª vez.

MILEBAG_AMBIENTE=producao
# Sem faixa de ambiente em produção.
MILEBAG_AMBIENTE_ROTULO=

# Na máquina local: http://localhost:8090. No servidor da empresa parceira: https://<domínio>, com
# MILEBAG_SITE=<domínio>, MILEBAG_PORTA_HTTP=80 e MILEBAG_PORTA_HTTPS=443 (certificado automático do Let's Encrypt).
MILEBAG_URL_PUBLICA=http://localhost:8090
MILEBAG_PORTA_HTTP=8090
MILEBAG_PORTA_HTTPS=
MILEBAG_SITE=:80

MILEBAG_PERFIL_SPRING=prod
MILEBAG_DOCUMENTACAO_API=false
MILEBAG_CONTAS_DE_TESTE=false

# Gerados por scripts/implantar.sh se estiverem vazios. Nunca reutilize os de homologação.
MILEBAG_JWT_SECRET=
MILEBAG_PG_ADMIN_SENHA=
MILEBAG_PG_APP_SENHA=

MILEBAG_VALHALLA_URL=http://host.docker.internal:8002
# Contato real exigido pela política de uso do Nominatim público.
MILEBAG_NOMINATIM_USER_AGENT=milebag-api (contato@empresa.com.br)

# Bot do Telegram (HU18). Desligado até existir o bot: crie com o @BotFather, ligue aqui e registre o webhook
# com scripts/telegram-webhook.sh (exige HTTPS público). O mesmo segredo vai aqui e no setWebhook.
# Para testar sem bot, MILEBAG_TELEGRAM_API_URL pode apontar para scripts/fake-telegram.cjs.
MILEBAG_TELEGRAM_HABILITADO=false
MILEBAG_TELEGRAM_BOT_TOKEN=
MILEBAG_TELEGRAM_BOT_USERNAME=
MILEBAG_TELEGRAM_WEBHOOK_SECRET=
MILEBAG_TELEGRAM_API_URL=https://api.telegram.org

# E-mail no Google Workspace do domínio (smtp.gmail.com / imap.gmail.com). Use senha de app (verificação em duas
# etapas ligada na conta) e IMAP ativado no Gmail. O Google só aceita como remetente a conta autenticada,
# por isso cada uso tem a sua conta.
# Conta padrão: pedidos de demonstração (HU38), convites, redefinição de senha e avisos. Os pedidos chegam nela mesma.
MILEBAG_SMTP_HABILITADO=false
MILEBAG_SMTP_HOST=smtp.gmail.com
MILEBAG_SMTP_PORT=587
MILEBAG_SMTP_USUARIO=contato@milebag.com.br
MILEBAG_SMTP_SENHA=
MILEBAG_SMTP_REMETENTE=contato@milebag.com.br
MILEBAG_DEMONSTRACAO_DESTINO=contato@milebag.com.br
# Caixa compartilhada de recebimento de BDO (HU02).
MILEBAG_IMAP_HABILITADO=false
MILEBAG_IMAP_HOST=
MILEBAG_IMAP_USUARIO=
MILEBAG_IMAP_SENHA=
# Conversa com o passageiro (HU18): envia e recebe pela caixa mensagem.motorista@. O Reply-To é
# <prefixo>entrega-{id}@<domínio>: com o prefixo "mensagem.motorista+" o Gmail entrega a resposta nessa caixa sem conta pega-tudo
# (deixe o prefixo vazio se o domínio tiver um pega-tudo apontando para ela).
MILEBAG_MENSAGERIA_IMAP_HABILITADO=false
MILEBAG_MENSAGERIA_IMAP_HOST=imap.gmail.com
MILEBAG_MENSAGERIA_IMAP_USUARIO=mensagem.motorista@milebag.com.br
MILEBAG_MENSAGERIA_IMAP_SENHA=
MILEBAG_MENSAGERIA_DOMINIO_EMAIL=milebag.com.br
MILEBAG_MENSAGERIA_PREFIXO_ENDERECO=mensagem.motorista+
MILEBAG_MENSAGERIA_SMTP_USUARIO=mensagem.motorista@milebag.com.br
MILEBAG_MENSAGERIA_SMTP_SENHA=
MILEBAG_MENSAGERIA_SMTP_REMETENTE=mensagem.motorista@milebag.com.br

# Web Push do aviso de BDO novo (HU32). Vazias, o implantar.sh gera o par VAPID na 1a implantacao.
# O assunto identifica o remetente para os servicos de push: um mailto: ou a URL publica (https).
MILEBAG_PUSH_CHAVE_PUBLICA=
MILEBAG_PUSH_CHAVE_PRIVADA=
MILEBAG_PUSH_ASSUNTO=mailto:noreply@milebag.local
